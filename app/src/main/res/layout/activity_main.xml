<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1E1E1E">

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchEnable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ATTIVA OROLOGIO NOTCH"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="12dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchHands"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="USO LANCETTE (OFF = PUNTINI)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Posizione Orizzontale (X)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <SeekBar
        android:id="@+id/seekBarX"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Posizione Verticale (Y)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <SeekBar
        android:id="@+id/seekBarY"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dimensione Orologio"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <SeekBar
        android:id="@+id/seekBarSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnHourColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COLORE ORE"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnMinuteColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COLORE MINUTI"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnSecondColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COLORE SECONDI"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnTicksColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COLORE TACCHE QUADRANTE"
        android:layout_marginTop="8dp" />

</LinearLayout>
