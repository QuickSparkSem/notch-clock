<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Configura orologio, orario laterale e batteria"
            android:textColor="#9E9E9E"
            android:textSize="14sp" />

        <!-- 1. GENERALE -->
        <LinearLayout
            android:id="@+id/cardGeneral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="GENERALE"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Attiva app overlay"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:background="#2C2C2C" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLandscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Mostra anche in modalità orizzontale"
                android:textColor="#E0E0E0"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:background="#2C2C2C" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAnalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Mostra orologio tondo (intorno al foro)"
                android:textColor="#E0E0E0"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- 2. POSIZIONE E AREA CENTRALE -->
        <LinearLayout
            android:id="@+id/cardPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="POSIZIONE E DIMENSIONE FORO / OROLOGIO"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Spostamento orizzontale (X)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvValueX"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 px"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekBarX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Spostamento verticale (Y)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvValueY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 px"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekBarY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Diametro orologio / area centrale"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvValueSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120 px"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekBarSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnResetPosition"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="#2C2C2C"
                android:text="Centra e ripristina dimensione"
                android:textAllCaps="false"
                android:textColor="#E0E0E0" />

        </LinearLayout>

        <!-- 3. ORARIO A SINISTRA E BATTERIA A DESTRA -->
        <LinearLayout
            android:id="@+id/cardSide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ORARIO A SINISTRA • BATTERIA A DESTRA"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLeftTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Orario a sinistra (Ore / Minuti)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchRightBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:minHeight="48dp"
                android:text="Batteria a destra (Numero + Fulmine)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSideColor"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#2A2A2A"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Colore caratteri e barretta"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Distanza dal foro / orologio"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvSideDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 px"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekSideDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Distanza dal bordo superiore (Y)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvSideY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42 px"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekSideY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grandezza caratteri"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvSideSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekSideSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Trasparenza"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvSideAlpha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekSideAlpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- 4. STILE OROLOGIO TONDO (SEZIONE ESPANDIBILE) -->
        <LinearLayout
            android:id="@+id/cardClockStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/headerClockStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STILE OROLOGIO TONDO"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/arrowClockStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodyClockStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnDialStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#2A2A2A"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Quadrante: Classico (12 tacche)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnHandStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#2A2A2A"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Lancette: A punta (lancetta)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnTickShape"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#2A2A2A"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Forma tacche: Lineari"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </LinearLayout>

        <!-- 5. COLORI, SPESSORE E LUNGHEZZA LANCETTE/TACCHE (SEZIONE ESPANDIBILE) -->
        <LinearLayout
            android:id="@+id/cardAdvancedHands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/headerAdvancedHands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LANCETTE E TACCHE (COLORI E MISURE)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/arrowAdvancedHands"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodyAdvancedHands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ORE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="LANCETTA ORE"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnHourColor"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="#2A2A2A"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Colore Ore"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lunghezza" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvHourLength" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50%" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekHourLength" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Spessore" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvHourThickness" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekHourThickness" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Trasparenza" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvHourAlpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekHourAlpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#2C2C2C" />

                <!-- MINUTI -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="LANCETTA MINUTI"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMinuteColor"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="#2A2A2A"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Colore Minuti"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lunghezza" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvMinuteLength" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="75%" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekMinuteLength" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Spessore" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvMinuteThickness" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekMinuteThickness" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Trasparenza" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvMinuteAlpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekMinuteAlpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#2C2C2C" />

                <!-- SECONDI -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="LANCETTA SECONDI"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSecondColor"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="#2A2A2A"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Colore Secondi"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lunghezza" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvSecondLength" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="88%" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekSecondLength" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Spessore" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvSecondThickness" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekSecondThickness" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Trasparenza" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvSecondAlpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekSecondAlpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#2C2C2C" />

                <!-- TACCHE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="TACCHE QUADRANTE"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTicksColor"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="#2A2A2A"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Colore Tacche"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lunghezza" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvTicksLength" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18%" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekTicksLength" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Spessore" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvTicksThickness" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekTicksThickness" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Trasparenza" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvTicksAlpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#9E9E9E" android:textSize="14sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekTicksAlpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnResetAll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#2C2C2C"
            android:text="Ripristina tutti i valori predefiniti"
            android:textAllCaps="false"
            android:textColor="#FF8A80" />

    </LinearLayout>
</ScrollView>
